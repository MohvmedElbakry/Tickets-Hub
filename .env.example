# Authentication & Encryption (Minimum 32 characters required in production)
JWT_SECRET=your_jwt_secret_here_min32chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min32chars
FINANCIAL_ENCRYPTION_KEY=replace_with_32_plus_random_characters_for_financial_encryption

# Application & Frontend URLs
# APP_URL is the canonical backend/app URL used in generated email links & callbacks
APP_URL=http://localhost:3000
# FRONTEND_URL is the client origin URL used for auth redirects and CORS
FRONTEND_URL=http://localhost:3000

# Distributed Rate Limiting (Redis Cloud / Upstash / Self-Hosted)
# Set REQUIRE_DISTRIBUTED_RATE_LIMIT=true in production to enforce distributed Redis rate limiting
REQUIRE_DISTRIBUTED_RATE_LIMIT=true
# Supports redis:// (standard) or rediss:// (TLS encrypted, recommended for Redis Cloud)
REDIS_URL="rediss://default:your_redis_password@your-redis-host.cloud.redislabs.com:6379"

# Kashier Payment Integration (Egypt Gateway)
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_TEST_MODE=true

# Database (Supabase / PostgreSQL)
# DATABASE_URL: Transaction pooled connection string (Port 6543 with pgbouncer=true for Vercel/Serverless)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=10&sslmode=require"
# DIRECT_URL: Direct PostgreSQL connection string (Port 5432) used exclusively for migrations (prisma migrate / db push)
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Email Configuration (Supports either Resend API or SMTP)
# Option A: Resend API (Recommended for Vercel / Cloud Functions)
RESEND_API_KEY=re_yourresendapikey
MAIL_FROM="TicketsHub Notifications <noreply@yourdomain.com>"

# Option B: SMTP (Mailgun, SendGrid, Amazon SES, Postmark)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_pass_here
SMTP_FROM="TicketsHub Notifications <noreply@yourdomain.com>"
