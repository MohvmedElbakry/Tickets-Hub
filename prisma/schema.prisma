generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int               @id @default(autoincrement())
  name               String
  email              String            @unique
  password_hash      String
  phone              String?
  role               String            @default("user")
  gender             String?
  points             Int               @default(0)
  birthdate          String?
  age                Int?
  instagram_username String?
  created_at         DateTime          @default(now())
  password_reset_token   String?
  password_reset_expires DateTime?
  password_changed_at    DateTime?
  token_version          Int               @default(0)
  email_verified            Boolean           @default(false)
  email_verification_token  String?
  email_verification_expires DateTime?
  is_deleted                Boolean           @default(false)
  deleted_at                DateTime?
  deleted_reason            String?
  deletion_token_hash       String?
  deletion_token_expires    DateTime?
  orders             Order[]
  resell_requests    ResellRequest[]
  points_history     PointsHistory[]
  pre_registrations  PreRegistration[]
  notifications      Notification[]
  organized_events   Event[]
  ticket_instances   TicketInstance[]
  sent_transfers     TicketTransfer[]  @relation("SentTransfers")
  received_transfers TicketTransfer[]  @relation("ReceivedTransfers")
  resale_listings    TicketResaleListing[] @relation("SellerListings")
  purchased_resales  TicketResaleListing[] @relation("BuyerPurchases")
  seller_balance     SellerBalance?
  payout_destinations PayoutDestination[]
  payout_requests    PayoutRequest[]
  ledger_entries     LedgerEntry[]
}

model Event {
  id                Int               @id @default(autoincrement())
  title             String
  description       String?
  date              DateTime
  event_date        String?
  event_time        String?
  location          String?
  venue             String?
  company_name      String?
  rules             String?
  google_maps_url   String?
  image_url         String?
  is_published      Boolean           @default(false)
  is_featured       Boolean           @default(false)
  featured_order    Int               @default(0)
  government        String            @default("Other")
  require_approval  Boolean           @default(false)
  qr_enabled_manual Boolean           @default(false)
  status            String?
  organizer_id      Int?
  organizer         User?             @relation(fields: [organizer_id], references: [id])
  created_at        DateTime          @default(now())
  ticket_types      TicketType[]
  orders            Order[]
  invitations       Invitation[]
  pre_registrations PreRegistration[]
}

model TicketType {
  id             Int             @id @default(autoincrement())
  event_id       Int
  event          Event           @relation(fields: [event_id], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          Decimal         @db.Decimal(12, 2)
  quantity_total Int
  quantity_sold  Int             @default(0)
  resale_queue   Int             @default(0)
  sale_start     DateTime?
  sale_end       DateTime?
  order_tickets   OrderTicket[]
  resell_requests ResellRequest[]
  invitations     Invitation[]
  ticket_instances TicketInstance[]

  @@index([event_id])
}

model Voucher {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  discount_percent Int
  max_uses         Int
  current_uses     Int      @default(0)
  expiration_date  DateTime
  name             String?
  created_by_type  String?
  created_by_id    Int?
  created_at       DateTime @default(now())
  orders           Order[]
}

model Order {
  id                     Int             @id @default(autoincrement())
  public_id              String          @unique @default(uuid())
  user_id                Int
  user                   User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event_id               Int
  event                  Event           @relation(fields: [event_id], references: [id], onDelete: Cascade)
  total_price            Decimal         @db.Decimal(12, 2)
  order_status           String          @default("pending")
  payment_method         String?
  is_paid                Boolean         @default(false)
  paid_at                DateTime?
  payment_deadline       DateTime?
  kashier_transaction_id String?         @unique
  kashier_order_id       String?         @unique
  kashier_url            String?
  qr_code_token          String?
  processing_payment     Boolean         @default(false)
  points_awarded         Boolean         @default(false)
  instagram_username     String?
  phone                  String?
  age                    Int?
  voucher_id             Int?
  voucher                Voucher?        @relation(fields: [voucher_id], references: [id], onDelete: SetNull)
  reserved_at            DateTime        @default(now())
  created_at             DateTime        @default(now())
  ticket_holders_raw     String?
  order_tickets          OrderTicket[]
  resell_requests        ResellRequest[]
  points_history         PointsHistory[]
  ticket_instances       TicketInstance[]
  resale_listings        TicketResaleListing[]
  payment_transactions   PaymentTransaction[]
  ledger_entries         LedgerEntry[]
  refund_records         RefundRecord[]

  @@index([user_id])
  @@index([event_id])
}

model OrderTicket {
  id                Int        @id @default(autoincrement())
  order_id          Int
  order             Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  ticket_type_id    Int
  ticket_type       TicketType @relation(fields: [ticket_type_id], references: [id], onDelete: Cascade)
  quantity          Int        @default(1)
  qty_original      Int?
  qty_resale        Int?
  price_at_purchase Decimal?   @db.Decimal(12, 2)
  price_each        Decimal?   @db.Decimal(12, 2)
  holder_name       String?
  scanned_count     Int        @default(0)
  is_used           Boolean    @default(false)
  status            String?
}

model ResellRequest {
  id             Int        @id @default(autoincrement())
  order_id       Int
  order          Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_ticket_id Int?
  ticket_type_id Int?
  ticket_type    TicketType? @relation(fields: [ticket_type_id], references: [id], onDelete: Cascade)
  user_id        Int
  user           User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status         String     @default("pending")
  reason         String?
  price          Decimal?   @db.Decimal(12, 2)
  paid_at        DateTime?
  created_at     DateTime   @default(now())

  @@index([status])
}

model PointsHistory {
  id          Int      @id @default(autoincrement())
  user_id     Int
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order_id    Int?
  order       Order?   @relation(fields: [order_id], references: [id], onDelete: SetNull)
  points      Int
  type        String
  description String?
  created_at  DateTime @default(now())
}

model Invitation {
  id             Int        @id @default(autoincrement())
  event_id       Int
  event          Event      @relation(fields: [event_id], references: [id], onDelete: Cascade)
  ticket_type_id Int
  ticket_type    TicketType @relation(fields: [ticket_type_id], references: [id], onDelete: Cascade)
  email          String
  status         String     @default("pending")
  invited_by     String?
  created_at     DateTime   @default(now())
}

model PreRegistration {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event_id   Int
  event      Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  message    String?
  type       String?
  link       String?
  read       Boolean  @default(false)
  created_at DateTime @default(now())
}

model Setting {
  id                      Int     @id @default(autoincrement())
  service_fee_percent     Decimal @default(10) @db.Decimal(12, 2)
  processing_fee_percent  Decimal @default(2.75) @db.Decimal(12, 2)
  fixed_fee_egp           Decimal @default(3) @db.Decimal(12, 2)
  settlement_hold_hours   Int     @default(24)
  min_payout_amount_egp   Decimal @default(100) @db.Decimal(12, 2)
}

enum TicketStatus {
  PENDING
  VALID
  CHECKED_IN
  TRANSFER_PENDING
  TRANSFERRED
  RESALE_LISTED
  RESOLD
  CANCELLED
  REFUNDED
}

model TicketInstance {
  id              Int          @id @default(autoincrement())
  public_id       String       @unique
  qr_token        String       @unique
  order_id        Int
  order           Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  ticket_type_id  Int
  ticket_type     TicketType   @relation(fields: [ticket_type_id], references: [id], onDelete: Cascade)
  owner_id        Int
  owner           User         @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  attendee_name   String?
  attendee_email  String?
  status          TicketStatus @default(PENDING)
  checked_in_at   DateTime?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  transfers       TicketTransfer[]
  resale_listing  TicketResaleListing?

  @@index([order_id])
  @@index([ticket_type_id])
  @@index([owner_id])
  @@index([status])
  @@index([qr_token])
  @@index([public_id])
}

model TicketTransfer {
  id                 Int            @id @default(autoincrement())
  ticket_id          Int
  ticket             TicketInstance @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  sender_id          Int
  sender             User           @relation("SentTransfers", fields: [sender_id], references: [id], onDelete: Cascade)
  recipient_email    String
  recipient_user_id  Int?
  recipient_user     User?          @relation("ReceivedTransfers", fields: [recipient_user_id], references: [id], onDelete: Cascade)
  status             String         @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED, CANCELLED
  token_hash         String         @unique
  expires_at         DateTime
  accepted_at        DateTime?
  declined_at        DateTime?
  cancelled_at       DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  @@index([status])
  @@index([token_hash])
  @@index([sender_id])
  @@index([recipient_user_id])
  @@index([recipient_email])
}

model TicketResaleListing {
  id                     Int            @id @default(autoincrement())
  public_id              String         @unique @default(uuid())
  ticket_instance_id     Int            @unique
  ticket_instance        TicketInstance @relation(fields: [ticket_instance_id], references: [id], onDelete: Cascade)
  seller_id              Int
  seller                 User           @relation("SellerListings", fields: [seller_id], references: [id], onDelete: Cascade)
  buyer_id               Int?
  buyer                  User?          @relation("BuyerPurchases", fields: [buyer_id], references: [id], onDelete: SetNull)
  status                 String         @default("LISTED") // DRAFT, LISTED, RESERVED, PAYMENT_PENDING, SOLD, CANCELLED, EXPIRED, HIDDEN, REJECTED
  original_price         Decimal        @db.Decimal(12, 2)
  price                  Decimal        @db.Decimal(12, 2)
  marketplace_fee        Decimal        @default(0) @db.Decimal(12, 2)
  seller_payout          Decimal        @db.Decimal(12, 2)
  currency               String         @default("EGP")
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt
  expires_at             DateTime?
  sold_at                DateTime?
  cancelled_at           DateTime?
  reason                 String?
  payment_reference      String?
  visibility             Boolean        @default(true)
  order_id               Int?
  order                  Order?         @relation(fields: [order_id], references: [id], onDelete: SetNull)
  reservation_expires_at DateTime?
  reserved_by_user_id    Int?
  payment_transactions   PaymentTransaction[]
  ledger_entries         LedgerEntry[]

  @@index([status])
  @@index([seller_id])
  @@index([buyer_id])
  @@index([reservation_expires_at])
}

model PaymentTransaction {
  id                      Int      @id @default(autoincrement())
  public_id               String   @unique @default(uuid())
  order_id                Int?
  order                   Order?   @relation(fields: [order_id], references: [id], onDelete: SetNull)
  resale_listing_id       Int?
  resale_listing          TicketResaleListing? @relation(fields: [resale_listing_id], references: [id], onDelete: SetNull)
  provider                String   @default("KASHIER")
  provider_transaction_id String?  @unique
  merchant_order_id       String?
  amount                  Decimal  @db.Decimal(12, 2)
  currency                String   @default("EGP")
  status                  String   // INITIATED, PENDING, CAPTURED, FAILED, REFUNDED, DISPUTED
  payment_method          String?
  raw_response            String?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  ledger_entries          LedgerEntry[]
  refund_records          RefundRecord[]

  @@index([order_id])
  @@index([resale_listing_id])
  @@index([status])
  @@index([provider_transaction_id])
}

model WebhookEvent {
  id                Int      @id @default(autoincrement())
  event_id          String   @unique
  provider          String   @default("KASHIER")
  event_type        String
  payload_hash      String?
  processing_status String   @default("PENDING") // PENDING, PROCESSED, FAILED, DUPLICATE
  received_at       DateTime @default(now())
  processed_at      DateTime?
  failure_reason    String?
  retry_count       Int      @default(0)

  @@index([processing_status])
}

model LedgerEntry {
  id                     Int                 @id @default(autoincrement())
  public_id              String              @unique @default(uuid())
  transaction_ref        String
  account_type           String              // CASH_CLEARING, SELLER_PENDING, SELLER_AVAILABLE, PLATFORM_REVENUE, PAYOUT_CLEARING, REFUND_CLEARING
  entry_type             String              // DEBIT or CREDIT
  amount                 Decimal             @db.Decimal(12, 2)
  currency               String              @default("EGP")
  description            String?
  user_id                Int?
  user                   User?               @relation(fields: [user_id], references: [id], onDelete: SetNull)
  order_id               Int?
  order                  Order?              @relation(fields: [order_id], references: [id], onDelete: SetNull)
  resale_listing_id      Int?
  resale_listing         TicketResaleListing? @relation(fields: [resale_listing_id], references: [id], onDelete: SetNull)
  payment_transaction_id Int?
  payment_transaction    PaymentTransaction? @relation(fields: [payment_transaction_id], references: [id], onDelete: SetNull)
  created_at             DateTime            @default(now())

  @@index([transaction_ref])
  @@index([account_type])
  @@index([user_id])
  @@index([created_at])
}

model SellerBalance {
  id                Int      @id @default(autoincrement())
  user_id           Int      @unique
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pending_amount    Decimal  @default(0) @db.Decimal(12, 2)
  available_amount  Decimal  @default(0) @db.Decimal(12, 2)
  withdrawn_amount  Decimal  @default(0) @db.Decimal(12, 2)
  held_amount       Decimal  @default(0) @db.Decimal(12, 2)
  currency          String   @default("EGP")
  updated_at        DateTime @updatedAt

  @@index([user_id])
}

model PayoutDestination {
  id                Int      @id @default(autoincrement())
  public_id         String   @unique @default(uuid())
  user_id           Int
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type              String   // BANK_ACCOUNT, INSTAPAY, VODAFONE_CASH
  account_name      String
  masked_details    String
  encrypted_details String
  is_active         Boolean  @default(true)
  is_verified       Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  payout_requests   PayoutRequest[]

  @@index([user_id])
}

model PayoutRequest {
  id                   Int               @id @default(autoincrement())
  public_id            String            @unique @default(uuid())
  idempotency_key      String            @unique @default(uuid())
  user_id              Int
  user                 User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  destination_id       Int
  destination          PayoutDestination @relation(fields: [destination_id], references: [id])
  amount               Decimal           @db.Decimal(12, 2)
  currency             String            @default("EGP")
  status               String            @default("REQUESTED") // REQUESTED, PENDING_REVIEW, APPROVED, PROCESSING, PAID, FAILED, CANCELLED, REVERSED
  failure_reason       String?
  provider_ref         String?
  approved_by_admin_id Int?
  requested_at         DateTime          @default(now())
  approved_at          DateTime?
  processed_at         DateTime?
  paid_at              DateTime?
  updated_at           DateTime          @updatedAt

  @@index([user_id])
  @@index([status])
}

model RefundRecord {
  id                     Int                @id @default(autoincrement())
  public_id              String             @unique @default(uuid())
  payment_transaction_id Int
  payment_transaction    PaymentTransaction @relation(fields: [payment_transaction_id], references: [id], onDelete: Cascade)
  order_id               Int?
  order                  Order?             @relation(fields: [order_id], references: [id], onDelete: SetNull)
  amount                 Decimal            @db.Decimal(12, 2)
  currency               String             @default("EGP")
  reason                 String
  status                 String             @default("REQUESTED") // REQUESTED, PROCESSING, COMPLETED, FAILED, REVERSED
  provider_ref           String?
  is_automated           Boolean            @default(false)
  created_by_admin_id    Int?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  @@index([payment_transaction_id])
  @@index([status])
}

model FinancialAuditLog {
  id            Int      @id @default(autoincrement())
  public_id     String   @unique @default(uuid())
  actor_id      Int?
  actor_role    String?
  action        String
  entity_type   String
  entity_id     String
  amount        Decimal? @db.Decimal(12, 2)
  reason        String?
  metadata_json String?
  created_at    DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([actor_id])
}


